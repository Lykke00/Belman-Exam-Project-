<?xml version="1.0" encoding="UTF-8"?>

<?import com.gluonhq.charm.glisten.mvc.View?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<View fx:controller="dk.belman.gui.pages.operator.QcPreviewController" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <center>
        <VBox fx:id="vBoxMain" prefHeight="435.0" prefWidth="532.0" styleClass="outer-background" stylesheets="@../../../css/belman.css" BorderPane.alignment="CENTER">
            <children>
                <VBox alignment="TOP_CENTER" spacing="30.0" styleClass="background" stylesheets="@../../../css/belman.css" VBox.vgrow="ALWAYS">
                    <children>
                        <Label text="Preview">
                            <font>
                                <Font name="System Bold" size="64.0" />
                            </font>
                        </Label>
                  <VBox spacing="25.0">
                     <children>
                                <Button maxWidth="700.0" mnemonicParsing="false" prefHeight="63.0" prefWidth="557.0" styleClass="generate-qc-report-btn" text="Add comment">
                                    <font>
                                        <Font size="59.0" />
                                    </font>
                                </Button>
                                <Button alignment="TOP_CENTER" maxWidth="700.0" mnemonicParsing="false" prefHeight="63.0" prefWidth="557.0" styleClass="take-photo-btn" text="Send QC report">
                                    <font>
                                        <Font size="59.0" />
                                    </font>
                                </Button>
                     </children>
                  </VBox>
                    </children>
                    <opaqueInsets>
                        <Insets />
                    </opaqueInsets>
                    <padding>
                        <Insets bottom="20.0" top="40.0" />
                    </padding>
                </VBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </center>
</View>
