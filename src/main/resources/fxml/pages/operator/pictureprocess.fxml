<?xml version="1.0" encoding="UTF-8"?>

<?import com.gluonhq.charm.glisten.mvc.View?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<View xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.belman.gui.pages.operator.PictureProcess.PictureProcessController">
   <center>
      <VBox prefWidth="500.0" styleClass="outer-background" stylesheets="@../../../css/belman.css" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="TOP_CENTER" spacing="30.0" styleClass="background" stylesheets="@../../../css/belman.css" VBox.vgrow="ALWAYS">
               <children>
                  <Label text="Take picture">
                     <font>
                        <Font name="System Bold" size="64.0" />
                     </font>
                  </Label>
                  <VBox alignment="CENTER" fillWidth="false" maxWidth="750.0" prefWidth="500.0" spacing="20.0">
                     <children>
                        <VBox fx:id="vBoxPicture" VBox.vgrow="ALWAYS" />
                        <VBox alignment="CENTER" minHeight="250.0" spacing="20.0">
                           <children>
                              <Button fx:id="btnTakePicture" maxWidth="700.0" mnemonicParsing="false" prefHeight="190.0" prefWidth="500.0" styleClass="begin-operator-btn" text="Take picture">
                                 <font>
                                    <Font size="59.0" />
                                 </font>
                              </Button>
                           </children>
                        </VBox>
                     </children>
                     <VBox.margin>
                        <Insets left="100.0" right="100.0" top="50.0" />
                     </VBox.margin>
                  </VBox>
               </children>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <padding>
                  <Insets bottom="20.0" top="40.0" />
               </padding>
            </VBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </center>
</View>
