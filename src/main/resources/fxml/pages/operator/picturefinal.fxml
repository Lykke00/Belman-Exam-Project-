<?xml version="1.0" encoding="UTF-8"?>

<?import com.gluonhq.charm.glisten.mvc.View?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import dk.belman.gui.pages.operator.pictureprocess.PictureFinalController?>
<PictureFinalController xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.belman.gui.pages.operator.pictureprocess.PictureFinalController">
   <center>
      <VBox styleClass="outer-background" stylesheets="@../../../css/belman.css" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="TOP_CENTER" prefWidth="376.0" spacing="30.0" styleClass="background" stylesheets="@../../../css/belman.css" VBox.vgrow="ALWAYS">
               <children>
                  <ScrollPane fx:id="scrollPanePictures" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" minHeight="300.0" pannable="true" styleClass="picture-process-scrollpane" vbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                     <VBox.margin>
                        <Insets left="20.0" right="20.0" />
                     </VBox.margin>
                     <content>
                        <HBox fx:id="hBoxPicturesContainer" alignment="CENTER_LEFT" spacing="10.0" />
                     </content>
                     <padding>
                        <Insets bottom="20.0" top="20.0" />
                     </padding>
                  </ScrollPane>
                  <Separator maxWidth="700.0" prefWidth="500.0" VBox.vgrow="ALWAYS" />
                  <VBox alignment="CENTER" minHeight="250.0" spacing="20.0">
                     <children>
                        <Button fx:id="btnSend" maxWidth="700.0" mnemonicParsing="false" prefHeight="190.0" prefWidth="500.0" text="Send">
                           <font>
                              <Font size="59.0" />
                           </font>
                           <styleClass>
                              <String fx:value="begin-operator-btn" />
                              <String fx:value="normal-btn" />
                           </styleClass>
                        </Button>
                     </children>
                     <VBox.margin>
                        <Insets left="20.0" right="20.0" />
                     </VBox.margin>
                  </VBox>
               </children>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <padding>
                  <Insets bottom="20.0" top="40.0" />
               </padding>
            </VBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </center>
</PictureFinalController>
